<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robotdog">

  <!-- Materials (shared across all assemblies) -->
  <material name="Steel">
    <color rgba="0.098 0.098 0.098 1.0"/>
  </material>

  <!-- Assembly includes -->
  <xacro:include filename="$(find robotdog_description)/urdf/assemblies/robotdog.urdf.xacro"/>

  <!-- Instantiate assemblies -->
  <xacro:robotdog prefix=""/>

</robot>